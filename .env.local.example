# ============================================================
# Korancenter – Miljövariabler (mall)
# Kopiera denna fil till .env.local och fyll i dina värden
# ============================================================

# ---- Supabase ----
# Hitta dessa i: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://din-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din_anon_nyckel_här
# service_role (secret) – används bara på servern för admin-åtgärder
SUPABASE_SERVICE_ROLE_KEY=din_service_role_nyckel_här

# ---- Klarna ----
# Hitta dessa i: Klarna Merchant Portal > Settings > API Credentials
KLARNA_USERNAME=din_klarna_username
KLARNA_PASSWORD=ditt_klarna_lösenord
# "sandbox" för test, "production" för produktion
KLARNA_ENV=sandbox

# ---- Resend ----
# Skapa API-nyckel på: resend.com/api-keys
RESEND_API_KEY=re_din_api_nyckel_här

# ---- Webbplats URL ----
# Lokalt: http://localhost:3000
# Produktion: https://www.korancenter.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000
